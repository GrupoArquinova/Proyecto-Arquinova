# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO (CONSTRUCTORA BACKEND)
# Copia este archivo como '.env' en la raíz y configura tus valores locales.
# ============================================================

# Servidor
SERVER_PORT=8080

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=constructora_web
DB_USERNAME=tu_usuario_mysql
DB_PASSWORD=tu_contrasena_mysql

# Seguridad JWT
JWT_SECRET=tu_clave_secreta_jwt_debe_tener_al_menos_256_bits_en_hexadecimal
# Duración de la sesión en milisegundos (3600000 = 1 hora). El panel la renueva solo mientras se trabaja.
JWT_EXPIRATION=3600000

# Swagger / OpenAPI: cerrado por defecto. Ponlo en true SOLO en tu equipo para ver la documentación.
APP_DOCS_PUBLICAS=false
# Token con el que Prometheus lee /actuator/prometheus (vacío = métricas cerradas). Genera uno largo y aleatorio.
METRICAS_TOKEN=

# Seguridad CORS (Orígenes permitidos del Frontend Angular)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Configuración de Servidor de Correo (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_google
MAIL_FROM=noreply@arquinova.com

# Cloudinary (subidas firmadas de imágenes/archivos desde el panel admin)
# Panel de Cloudinary -> Settings -> API Keys. El API secret NUNCA va en el frontend.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_FOLDER=arquinova

# Asistente de IA (Gemini): clave de Google AI Studio (nunca en application.yaml) y modelo opcional
GEMINI_API_KEY=tu_clave_de_gemini
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODEL_RESPALDO=gemini-3.6-flash

# Correo de la empresa que recibe el aviso de cada solicitud nueva (sin valor por defecto: si falta, no se envia el aviso)
APP_CONTACTO_CORREO_AVISO=

# Captcha Cloudflare Turnstile del formulario de contacto: clave SECRETA del widget. Vacio = captcha desactivado.
# La site key (publica) va en el frontend, no aqui.
TURNSTILE_SECRET=
# Si Cloudflare no responde: false (por defecto) = rechaza con 503; true = deja pasar el formulario
# TURNSTILE_FALLO_ABIERTO=false

# Opcionales (valores por defecto entre parentesis)
# JWT_SESION_MAXIMA_HORAS=12            vida maxima absoluta de una sesion aunque se renueve
# APP_MAX_CUERPO_BYTES=65536            tope del cuerpo de las peticiones a /api/**
# APP_LEGAL_VERSION_POLITICA=2026-10    version de la politica de datos que se guarda con cada consentimiento
# APP_RETENCION_SOLICITUDES_MESES=24    meses que se conservan las solicitudes (0 = no borrar)
# APP_CONTACTO_CONFIRMACIONES_MAX_HORA=60
# APP_CONTACTO_CONFIRMACIONES_MAX_DIA=300
# GEMINI_CONCURRENCIA_MAXIMA=5
# GEMINI_CUOTA_DIARIA=1000              preguntas al dia entre todos los visitantes (0 = sin tope)
# docker-compose exige ademas: MYSQL_ROOT_PASSWORD, DB_PASSWORD, RABBITMQ_PASSWORD, GRAFANA_PASSWORD
