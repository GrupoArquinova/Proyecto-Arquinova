<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Propiedades por defecto -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="constructora-backend"/>

    <!-- ─── Perfil Desarrollo: Consola con formato legible y Correlation ID ─── -->
    <springProfile name="default,dev,local">
        <appender name="CONSOLE_DEV" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) [%cyan(%X{correlationId:-NO_CID})] %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE_DEV"/>
        </root>
        <logger name="com.constructora_backend" level="DEBUG"/>
    </springProfile>

    <!-- ─── Perfil Producción: JSON Estructurado para ELK, Loki o Datadog ─── -->
    <springProfile name="prod,production">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <timeZone>America/Bogota</timeZone>
                    </timestamp>
                    <version/>
                    <logLevel/>
                    <threadName/>
                    <loggerName/>
                    <mdc>
                        <includeMdcKeyName>correlationId</includeMdcKeyName>
                    </mdc>
                    <pattern>
                        <pattern>
                            {
                                "service": "${appName}",
                                "severity": "%level",
                                "class": "%logger{40}",
                                "line": "%line"
                            }
                        </pattern>
                    </pattern>
                    <message/>
                    <stackTrace>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerThrowable>30</maxDepthPerThrowable>
                            <maxLength>2048</maxLength>
                            <shortenedClassNameLength>20</shortenedClassNameLength>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                </providers>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
        <logger name="com.constructora_backend" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
    </springProfile>

</configuration>
